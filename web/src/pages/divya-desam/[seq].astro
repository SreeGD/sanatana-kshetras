---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const [entries, temples] = await Promise.all([getCollection('divya-desam'), getCollection('temples')]);
  const templeById = new Map(temples.map((t) => [t.data.id, t]));
  return entries.map((entry) => ({
    params: { seq: String(entry.data.seq) },
    props: { entry, temple: entry.data.temple_ref ? templeById.get(entry.data.temple_ref) : undefined },
  }));
}

const { entry, temple } = Astro.props;
const d = entry.data;
const base = import.meta.env.BASE_URL;

const regionLabels: Record<string, string> = {
  'chola-nadu': 'Chola Nadu',
  'nadu-nadu': 'Nadu Nadu',
  'thondai-nadu': 'Thondai Nadu',
  'malai-nadu': 'Malai Nadu',
  'pandya-nadu': 'Pandya Nadu',
  'vada-nadu': 'Vada Nadu',
  celestial: 'Celestial',
};
---
<Base title={`Divya Desam #${d.seq}: ${d.name}`}>
  <article class="wrap dd-entry-page">
    <p class="crumb"><a href={`${base}divya-desam/`}>&larr; All 108 Divya Desam</a></p>
    <p class="seq-tag">Divya Desam #{d.seq} · {regionLabels[d.region_group] ?? d.region_group}</p>
    <h1>{d.name}</h1>

    {d.physical ? (
      temple ? (
        <p>
          This Divya Desam is a physical temple. See the full entry —{' '}
          <a href={`${base}temples/${temple.data.id}/`}>{temple.data.name}</a> — for history,
          sources, darshan hours, and how to reach it.
        </p>
      ) : (
        <p class="review-flags">The linked temple entry for this Divya Desam could not be resolved.</p>
      )
    ) : (
      <p>
        {d.celestial_note ?? 'This Divya Desam is a celestial abode with no earthly location.'}{' '}
        See the <a href={`${base}beyond-earth/`}>Beyond Earth</a> section for related cosmology entries.
      </p>
    )}

    {d.sources?.length ? (
      <section class="sources">
        <h2>Sources for this classification</h2>
        <ul>
          {d.sources.map((s) => (
            <li><strong>{s.type.replace('_', ' ')}:</strong> {s.text}{s.reference ? ` — ${s.reference}` : ''}{s.note ?? ''}</li>
          ))}
        </ul>
      </section>
    ) : null}

    {d.review_flags?.length ? (
      <div class="review-flags">
        <h3>For review</h3>
        <ul>{d.review_flags.map((f) => <li>{f}</li>)}</ul>
      </div>
    ) : null}
  </article>
</Base>

<style>
  .dd-entry-page { padding-block: 2rem 3rem; max-width: 40rem; }
  .crumb a { text-decoration: none; color: var(--ink-muted); font-size: 0.9rem; }
  .seq-tag { color: var(--gold); font-size: 0.9rem; margin-bottom: 0.25rem; }
  .sources ul, .review-flags ul { padding-left: 1.25rem; font-size: 0.92rem; }
</style>
