{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "realm.schema.json",
  "title": "Realm (Loka) / Beyond-Earth entry front matter",
  "type": "object",
  "required": ["id", "name", "category", "tradition_accounts"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "enum": ["loka", "spiritual-world"] },
    "governing_deity": { "type": "string" },
    "position_in_cosmology": { "type": "string" },
    "tradition_accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tradition", "description", "sources"],
        "properties": {
          "tradition": { "$ref": "common.schema.json#/definitions/tradition" },
          "description": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/definitions/sourceCitation" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["address"] },
      { "required": ["coordinates"] },
      { "required": ["darshan_hours"] },
      { "required": ["how_to_reach"] }
    ]
  },
  "additionalProperties": false
}
